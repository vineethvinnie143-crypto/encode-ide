{
  "name": "encode",
  "version": "0.1.0",
  "private": true,
  "description": "eNCode monorepo: the desktop IDE and its in-house packages.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @encode/desktop dev",
    "build": "pnpm --filter @encode/desktop build",
    "start": "pnpm --filter @encode/desktop start",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/test.mjs",
    "fuzz": "node scripts/fuzz.mjs",
    "traces": "node scripts/edit-traces.mjs",
    "editor-issue": "node scripts/editor-issue.mjs",
    "e2e": "pnpm --filter @encode/desktop e2e",
    "perf": "pnpm --filter @encode/desktop perf",
    "dist": "pnpm --filter @encode/desktop dist",
    "test:browser": "pnpm --filter @encode/editor-view test:browser"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
