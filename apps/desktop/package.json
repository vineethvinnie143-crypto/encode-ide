{
  "name": "@encode/desktop",
  "productName": "eNCode",
  "version": "0.1.0",
  "private": true,
  "description": "eNCode \u2014 an AI-first desktop IDE with an autonomous coding agent.",
  "author": "eNCode",
  "license": "MIT",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "perf": "node scripts/e2e.mjs perf.mjs",
    "fake-provider": "node scripts/fake-provider.mjs",
    "package": "electron-builder --win --x64",
    "package:dir": "electron-builder --win --x64 --dir",
    "dist": "node scripts/build.mjs && electron-builder --win --x64"
  },
  "devDependencies": {
    "@encode/core": "workspace:*",
    "@encode/diff": "workspace:*",
    "@encode/editor": "workspace:*",
    "@encode/editor-view": "workspace:*",
    "@encode/git": "workspace:*",
    "@encode/lsp": "workspace:*",
    "@encode/permissions": "workspace:*",
    "@encode/protocol": "workspace:*",
    "@encode/providers": "workspace:*",
    "@encode/router": "workspace:*",
    "@encode/sandbox": "workspace:*",
    "@encode/testkit": "workspace:*",
    "@encode/text": "workspace:*",
    "@encode/tools": "workspace:*",
    "@encode/workspace": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
