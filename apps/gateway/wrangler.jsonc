// The eNCode free-tier gateway on Cloudflare Workers. DEPLOY.md walks
// through the first deploy: it creates the D1 database and KV namespace whose
// ids replace the placeholders below, and sets the secrets, which never live
// in this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "encode-gateway",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // request.signal aborts when the client disconnects, so the gateway stops the upstream at once.
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [
      { "name": "USER_QUOTA", "class_name": "UserQuotaObject" },
      { "name": "CONTROL", "class_name": "ControlObject" },
      { "name": "ADDRESS_LIMITER", "class_name": "AddressLimiterObject" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserQuotaObject", "ControlObject", "AddressLimiterObject"] }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "encode-gateway",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "00000000000000000000000000000000" }],

  // OpenRouter's counters, the free pool (rebuilt hourly), alerts and session cleanup.
  "triggers": { "crons": ["*/5 * * * *"] },

  // Settings that are not secret. Secrets (OPENROUTER_API_KEY, GATEWAY_SECRET,
  // ADMIN_TOKEN, ALERT_WEBHOOK_URL) are set with `wrangler secret put`.
  "vars": {
    "ENVIRONMENT": "production",
    "SIGNUP_MODE": "allowlist",
    "ALLOWED_GITHUB_LOGINS": "",
    "MIN_GITHUB_ACCOUNT_AGE_DAYS": "30",
    "GITHUB_CLIENT_ID": "",
    "APP_TITLE": "eNCode",
    "GLOBAL_REQUESTS_PER_DAY": "950",
    "GLOBAL_REQUESTS_PER_MINUTE": "18"
  }
}
