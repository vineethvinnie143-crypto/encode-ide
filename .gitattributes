# Normalise line endings in the repository; check out LF everywhere so
# Windows and Unix builds see byte-identical sources.
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.ico binary
*.jpg binary
*.gif binary
*.woff binary
*.woff2 binary

# A benchmark task about a file with Windows line ends: it must reach every checkout with them.
packages/bench/tasks/crlf-preserve/project/src/legacy.js text eol=crlf
