          "name": "ToolSearch",
          "input": {
            "query": "select:Debug"
          }
        }
      ]
    },
    {
      "calls": [
        {
          "name": "Debug",
          "input": {
            "action": "start",
            "file": "report.js",
            "breakpoints": [
              {
                "file": "src/discount.js",
                "line": 7,
                "condition": "subtotal === 100"
              }
            ]
          }
        }
      ]
    },
    {
      "calls": [
        {
          "name": "Debug",
          "input": {
