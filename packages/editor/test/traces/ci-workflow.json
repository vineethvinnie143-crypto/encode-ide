   "paste": "\n      # The programs testers are given, unsigned: an installer and a portable program. Each is started the\n      # way a tester starts it, so a broken package fails here and not on someone's computer.\n      - name: Package\n        run: pnpm --filter @encode/desktop package\n\n      - name: Packaged program starts\n        working-directory: apps/desktop\n        run: node scripts/packaged-smoke.mjs release/win-unpacked/eNCode.exe\n\n      - name: Portable program starts\n        working-directory: apps/desktop\n        run: node scripts/packaged-smoke.mjs (Get-ChildItem release/*-portable.exe).FullName\n\n      - name: Installer installs, starts and uninstalls\n        working-directory: apps/desktop\n        run: node scripts/installer-smoke.mjs\n\n      - name: Name the build\n        id: build\n        run: |\n          $short = $env:ENCODE_COMMIT.Substring(0, 7)\n          Add-Content -Path $env:GITHUB_OUTPUT -Value \"name=eNCode-windows-$short-run${{ github.run_number }}\"\n\n      # Only what reached main, or was started by hand on a branch, is kept to be handed out.\n      - name: Keep the programs\n        if: github.event_name != 'pull_request'\n        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\n        with:\n          name: ${{ steps.build.outputs.name }}\n          path: |\n            apps/desktop/release/*-setup.exe\n            apps/desktop/release/*-portable.exe\n            TESTING.md\n          if-no-files-found: error\n          retention-days: 30\n",
   "t": 38939
